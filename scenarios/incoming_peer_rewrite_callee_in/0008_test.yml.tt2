flow:
  - start|DEFAULT_ONREPLY:
  - start|REPLY_ROUTE_NAT:
  - start|ROUTE_ENTRY:
  - return|ROUTE_ENTRY:
  - start|ROUTE_APPLY_HEADER_RULES:
  - return|ROUTE_APPLY_HEADER_RULES:
  - start|ROUTE_SET_COLP_IDENTITY:
  - return|ROUTE_SET_COLP_IDENTITY:
  - start|ROUTE_PREPARE_UA:
  - return|ROUTE_PREPARE_UA:
  - start|ROUTE_REMOVE_TIMER_SUPP_REQ:
  - return|ROUTE_REMOVE_TIMER_SUPP_REQ:
  - start|REPLY_ROUTE_RTPENGINE:
  - start|ROUTE_DOWNSTREAM_SET_RTP_TRANSPORT_SDES_DTLS:
  - return|ROUTE_DOWNSTREAM_SET_RTP_TRANSPORT_SDES_DTLS:
  - return|REPLY_ROUTE_RTPENGINE:
  - start|REPLY_ROUTE_NAT_CONTINUE:
  - start|ROUTE_EXIT:
  - start|ROUTE_RUNTIME:
  - return|ROUTE_RUNTIME:
  - start|dialog:start:
  - return|dialog:start:
sip_in:
  - 'SIP/2.0 200 OK'
  - 'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=[^;]+;ice_caller=strip;ice_callee=strip;aset=\d+;rtpprx=yes;vsf=[^;]+>'
  - 'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'Record-Route: <sip:[% server_ip %];r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'From: <sip:[% scenarios.0.username %]@incoming-peer-rewrite-callee-in.scenarios.test>;tag=[\w-]+'
  - 'To: <sip:00[% incoming_peer_rewrite_callee_in_scenarios_test.testuser1003.phone_number %]@incoming-peer-rewrite-callee-in.scenarios.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Allow: INVITE,ACK,OPTIONS,CANCEL,BYE,UPDATE,PRACK,INFO,SUBSCRIBE,NOTIFY,REFER,MESSAGE,PUBLISH'
  - 'Contact: <sip:127.0.0.1:5080;transport=udp>'
  - 'Content-Type: application/sdp'
  - 'Content-Length:\s+\d+'
  - 'v=0'
  - 'o=user1 \d+ \d+ IN IP4 [% scenarios.0.responders.0.ip %]'
  - 's=-'
  - 'c=IN IP4 [% scenarios.0.responders.0.ip %]'
  - 't=0 0'
  - 'm=audio [% scenarios.0.responders.0.mport %] RTP/AVP 8'
  - 'a=rtpmap:8 PCMA/8000'
  - 'a=sendrecv'
  - 'a=ptime:50'
sip_out:
  - [
      'SIP/2.0 200 OK',
      'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=[^;]+;ice_caller=strip;ice_callee=strip;aset=\d+;rtpprx=yes;vsf=[^;]+>',
      'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>',
      'Record-Route: <sip:[% server_ip %];r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>',
      'From: <sip:[% scenarios.0.username %]@incoming-peer-rewrite-callee-in.host0.peer.scenarios.test>;tag=[\w-]+',
      'To: <sip:00[% incoming_peer_rewrite_callee_in_scenarios_test.testuser1003.phone_number %]@incoming-peer-rewrite-callee-in.scenarios.test>;tag=[\w-]+',
      'CSeq: \d+ INVITE',
      'Allow: INVITE,ACK,OPTIONS,CANCEL,BYE,UPDATE,PRACK,INFO,SUBSCRIBE,NOTIFY,REFER,MESSAGE,PUBLISH',
      'Contact: <sip:127.0.0.1:5080;transport=udp>',
      'Content-Type: application/sdp',
      'Content-Length:\s+\d+',
      'P-Out-Socket: udp:[% server_ip %]:5060',
      'v=0',
      'o=user1 \d+ \d+ IN IP4 [% server_ip %]',
      's=-',
      't=0 0',
      'm=audio \d+ RTP/AVP 8',
      'c=IN IP4 [% server_ip %]',
      'a=rtpmap:8 PCMA/8000',
      'a=sendrecv',
      'a=rtcp:\d+',
      'a=ptime:50',
    ]
