  - 'CSeq: \d+ INVITE'
  - 'Server: Sipwise NGCP LB'
  - 'Content-Length:\s+0'
- - 'SIP/2.0 180 Ringing'
  - 'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=[^;]+;evmona=yes;evmonb=yes;ice_caller=strip;ice_callee=strip;aset=\d+;rtpprx=yes>'
  - 'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'Record-Route: <sip:[% server_ip %];r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'From: <sip:[% scenarios.0.username %]@invite-group-cfu-inactive.scenarios-pbx.test>;tag=[\w-]+'
  - 'To: <sip:[% invite_group_cfu_inactive_scenarios_pbx_test.testgroup1010.pbx_extension %]@invite-group-cfu-inactive.scenarios-pbx.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Content-Length:\s+0'
  - 'P-Asserted-Identity: "[% invite_group_cfu_inactive_scenarios_pbx_test.testgroup1010.pbx_extension %]" <sip:[% invite_group_cfu_inactive_scenarios_pbx_test.testgroup1010.pbx_extension %]@invite-group-cfu-inactive.scenarios-pbx.test>'
  - 'Contact: <sip:ngcp-lb@[% server_ip %]:5060;ngcpct=[^;]+>'
- - 'SIP/2.0 200 OK'
  - 'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=[^;]+;evmona=yes;evmonb=yes;ice_caller=strip;ice_callee=strip;aset=\d+;rtpprx=yes>'
  - 'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
