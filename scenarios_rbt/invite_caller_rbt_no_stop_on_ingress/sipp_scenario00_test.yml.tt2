messages:
- - 'SIP/2.0 100 Trying'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>'
  - 'CSeq: \d+ INVITE'
  - 'Server: Sipwise NGCP LB'
  - 'Content-Length:\s+0'
- - 'SIP/2.0 407 Proxy Authentication Required'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Proxy-Authenticate: Digest realm="invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test", nonce="[^"]+"'
  - 'Server: Sipwise NGCP Proxy'
  - 'Content-Length:\s+0'
- - 'SIP/2.0 100 Trying'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>'
  - 'CSeq: \d+ INVITE'
  - 'Server: Sipwise NGCP LB'
  - 'Content-Length:\s+0'
- - 'SIP/2.0 183 Progress'
  - 'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=[^;]+;ice_caller=strip;ice_callee=strip;aset=\d+;rtpprx=yes'
  - 'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'Record-Route: <sip:[% server_ip %];r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Content-Type: application/sdp'
  - 'Content-Length:\s+\d+'
  - 'Contact: <sip:ngcp-lb@[% server_ip %]:5060;ngcpct=[^;]+>'
  - 'v=0'
  - 'o=sems \d+ \d+ IN IP4 [% server_ip %]'
  - 's=sems'
  - 'c=IN IP4 [% server_ip %]'
  - 't=0 0'
  - 'm=audio \d+ RTP/AVP 8'
  - 'a=rtpmap:8 PCMA/8000'
  - 'a=sendrecv'
  - 'a=rtcp:\d+'
  - 'a=ptime:50'
- - 'SIP/2.0 183 Session Progress'
  - 'Record-Route: <sip:127.0.0.1:5062;lr=on;ftag=[^;]+;did=.+>'
  - 'Record-Route: <sip:127.0.0.1;r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'Record-Route: <sip:[% server_ip %];r2=on;lr=on;ftag=[^;]+;ngcplb=yes;nat=yes;socket=udp:[% server_ip %]:5060>'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Content-Type: application/sdp'
  - 'Content-Length:\s+\d+'
  - 'Contact: <sip:ngcp-lb@[% server_ip %]:5060;ngcpct=[^;]+>'
  - 'v=0'
  - 'o=user1 \d+ \d+ IN IP4 [% server_ip %]'
  - 's=-'
  - 'c=IN IP4 [% server_ip %]'
  - 't=0 0'
  - 'm=audio \d+ RTP/AVP 8'
  - 'a=rtpmap:8 PCMA/8000'
  - 'a=sendrecv'
  - 'a=rtcp:\d+'
  - 'a=ptime:50'
- - 'SIP/2.0 200 \w+'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>'
  - 'CSeq: \d+ CANCEL'
  - 'Content-Length:\s+0'
- - 'SIP/2.0 487 Request terminated'
  - 'From: <sip:[% scenarios.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'To: <sip:[% scenarios.0.responders.0.username %]@invite-caller-rbt-no-stop-on-ingress.scenarios-rbt.test>;tag=[\w-]+'
  - 'CSeq: \d+ INVITE'
  - 'Content-Length:\s+0'
